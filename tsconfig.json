{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "vite/client"],
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "projects/**/*.ts"]
}
