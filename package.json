{
    "name": "browser-testbench-director",
    "private": true,
    "type": "module",
    "scripts": {
        "guess-the-price": "node --import tsx projects/youtube/shorts/binderium/guess-the-price/generate.ts",
        "test:timeline": "node --import tsx --test tests/**/*.spec.ts",
        "typecheck:timeline": "tsc -p tsconfig.json",
