        "testbench:start:no-open": "browser-testbench start --no-open"
    },
    "devDependencies": {
        "@fontsource/lilita-one": "5.3.0",
        "@types/node": "^24.5.2",
        "browser-testbench": "^0.5.0",
        "esbuild": "^0.28.1",
        "onnxruntime-web": "1.29.0",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "sharp": "^0.35.4",
        "tsx": "^4.23.12",
        "typescript": "~5.9.2"
    }
}
